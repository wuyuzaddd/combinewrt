{
  "id": "nas",
  "layer": "package/kernel",
  "title": "NAS packages",
  "experimental": false,
  "description": "Installs Samba and disk tools and writes a default share. It never partitions, formats or mounts a disk.",
  "packages": [
    "samba4-server",
    "luci-app-samba4",
    "kmod-usb-storage",
    "block-mount",
    "kmod-fs-ext4",
    "kmod-fs-vfat",
    "kmod-fs-exfat",
    "ntfs-3g",
    "e2fsprogs",
    "smartmontools",
    "rsync"
  ],
  "kernelConfig": [],
  "generatedFiles": [
    "/etc/config/samba4"
  ],
  "nas": {
    "shareName": "share",
    "path": "/mnt",
    "readOnly": false,
    "guestOk": false
  }
}
