# ImmortalWrt source-build fragment for kernel line 6.6 (openwrt-24.10).
#
# Target composition, image variant and package selection are generated from
# the BuildPlanV2 by src/lib/build/source.ts; this fragment only carries
# options that belong to the kernel line itself.
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=300
CONFIG_GRUB_CONSOLE=y
# The combined image boots the ext4/squashfs rootfs directly; no initramfs.
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
