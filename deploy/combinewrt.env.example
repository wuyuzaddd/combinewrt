# /etc/combinewrt.env
# Install with: install -m 0600 deploy/combinewrt.env.example /etc/combinewrt.env
# Never commit real secrets. Generate SESSION_SECRET with:
#   openssl rand -base64 48

NODE_ENV=production
PORT=3000
APP_ORIGIN=https://firmware.example.lan

# SQLite database and downloaded artifacts live outside the checkout.
DATABASE_PATH=/var/lib/combinewrt/combinewrt.db
ARTIFACT_CACHE_DIR=/var/lib/combinewrt/artifacts
ARTIFACT_RETENTION_DAYS=7
# Optional: site artifact cache ceiling in bytes; 0 = unlimited (default: 20 GiB)
ARTIFACT_CACHE_MAX_BYTES=21474836480
# Source watch: six-hourly dllkids index checks; cached index bytes live beside the DB.
SOURCE_WATCH_INTERVAL_HOURS=6
SOURCE_CACHE_DIR=/var/lib/combinewrt/source-cache

# Required. Use a dedicated, non-root account.
SESSION_SECRET=
ADMIN_PASSWORD_HASH=

# apk-tools 3 is needed to read feed indexes. Point at a static or installed apk.
APK_BIN=/opt/combinewrt/bin/apk

# ImmortalWrt seed; after first start the active base version is stored in SQLite.
IMMORTALWRT_BASE_VERSION=25.12.2

# Pinned package sources.
DLLKIDS_FEED_URL=https://down.dllkids.xyz/openwrt-feed/25.12/x86_64
DLLKIDS_INDEX_SHA256=04a549ed7028b126218002b126cbc60eb3a4bdc3463f15425bce3ba6b91a04ba
SUPPLEMENT_FEED_URL=https://wuyuzaddd.github.io/combinewrt-packages/supplement/25.12.2/x86_64
SUPPLEMENT_KEY_URL=https://wuyuzaddd.github.io/combinewrt-packages/keys/combinewrt-feed.pub.pem
SUPPLEMENT_KEY_FINGERPRINT=f71286670f3cc138ec4f55e650c6aa4ed2bd7fff7d29851aef2ac53bae72d083
SUPPLEMENT_FEED_COMMIT=

# Image feed set (ticket 09). Optional IMMORTALWRT_MIRROR replaces the canonical
# official base; the feed base is the project supplement/extension site (the
# version-frozen /supplement/<version>/<target>/ paths are appended).
IMMORTALWRT_MIRROR=
COMBINEWRT_FEED_BASE_URL=https://wuyuzaddd.github.io/combinewrt-packages
SUPPLEMENT_INDEX_SHA256=
EXTENSION_INDEX_SHA256=


# Optional: supplement source watch: upstream commit -> gated build -> publish.
SUPPLEMENT_SOURCE_REPO=kiddin9/op-packages
SUPPLEMENT_SOURCE_REF=main
SUPPLEMENT_TARGET=x86_64
# Optional: public audit records written by the feed repo publish workflow.
SUPPLEMENT_PUBLISH_AUDIT_URL=https://wuyuzaddd.github.io/combinewrt-packages/publish.json
SUPPLEMENT_STAGING_AUDIT_URL=https://wuyuzaddd.github.io/combinewrt-packages/staging.json
# Optional: set to false to disable the supplement source watch.
SUPPLEMENT_WATCH_ENABLED=true
# Image builds. BUILD_ADAPTER=fake is only for local UI work.
BUILD_ADAPTER=github
BUILD_REPO=wuyuzaddd/combinewrt-build
BUILD_REPO_TOKEN=
BUILD_WORKFLOW=build.yml
SUPPLEMENT_WORKFLOW=packages.yml
BUILD_REF=main
