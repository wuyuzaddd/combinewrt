# Copy to deploy/compose.env (gitignored) and fill in real values.
# `docker compose` reads it through `env_file`, not for interpolation.

# Required: >= 32 characters. Generate with `openssl rand -hex 32`.
SESSION_SECRET=

# Required: `npm run hash-password -- '<password>'` (prints scrypt$...).
# IMPORTANT: `docker compose` interpolates `$` inside env_file values, so escape
# every separator: scrypt$$<salt>$$<hash>. An unescaped value arrives truncated
# and the app refuses to start with "ADMIN_PASSWORD_HASH must use ...".
ADMIN_PASSWORD_HASH=

# Public origin the browser uses. https here also turns on Secure cookies.
APP_ORIGIN=http://localhost:3100

# fake = no GitHub calls (UI/e2e work, builds never leave the machine).
# github = real ImageBuilder / source builds on the build repository.
BUILD_ADAPTER=fake
# BUILD_REPO=wuyuzaddd/combinewrt-build
# BUILD_REPO_TOKEN=
# BUILD_WORKFLOW=build.yml
# SOURCE_BUILD_WORKFLOW=source-build.yml
# BUILD_REF=main

# Artifact cache: retention, total ceiling, and the per-download cap.
ARTIFACT_RETENTION_DAYS=7
ARTIFACT_CACHE_MAX_BYTES=21474836480
ARTIFACT_MAX_BYTES=2147483648

# `apk` is provided by the Alpine base image.
APK_BIN=apk
SOURCE_WATCH_INTERVAL_HOURS=6

# Build/runtime overrides for `docker compose` itself (export in the shell or
# put in the project .env, not in this env_file):
#   BUILD_BASE_IMAGE=nginx:alpine        # when Docker Hub is unreachable
#   BUILD_NODE_OPTIONS=--max-old-space-size=6144
#   RUNTIME_NODE_OPTIONS=--dns-result-order=ipv4first
