# Required: openssl rand -base64 48 (at least 32 characters)
SESSION_SECRET=
# Required: npm run hash-password -- 'your-admin-password'
ADMIN_PASSWORD_HASH=
# Optional, defaults to ./data/combinewrt.db
DATABASE_PATH=./data/combinewrt.db
# Optional, defaults to http://localhost:3000
APP_ORIGIN=http://localhost:3000
# Optional: apk-tools 3 binary for reading feed indexes (default: apk)
APK_BIN=apk
# Optional: pinned ImmortalWrt release (default: 25.12.2)
IMMORTALWRT_BASE_VERSION=25.12.2
# Optional: pinned dllkids feed index (URL + sha256 of packages.adb)
DLLKIDS_FEED_URL=https://down.dllkids.xyz/openwrt-feed/25.12/x86_64
DLLKIDS_INDEX_SHA256=04a549ed7028b126218002b126cbc60eb3a4bdc3463f15425bce3ba6b91a04ba
# Optional: signed supplement feed and its public key
SUPPLEMENT_FEED_URL=https://wuyuzaddd.github.io/combinewrt-packages/x86_64
SUPPLEMENT_KEY_URL=https://wuyuzaddd.github.io/combinewrt-packages/keys/combinewrt-feed.pub.pem
SUPPLEMENT_KEY_FINGERPRINT=f71286670f3cc138ec4f55e650c6aa4ed2bd7fff7d29851aef2ac53bae72d083
# Optional: supplement source commit; empty means only the key fingerprint is pinned
SUPPLEMENT_FEED_COMMIT=
# Optional: fake (default, local stub) or github (dispatch to Actions)
BUILD_ADAPTER=fake
# Required when BUILD_ADAPTER=github: owner/repo of the public build repository
BUILD_REPO=
# Required when BUILD_ADAPTER=github: fine-grained PAT with Actions: write
BUILD_REPO_TOKEN=
# Optional: workflow file name in the build repository (default: build.yml)
BUILD_WORKFLOW=build.yml
# Optional: branch in the build repository (default: main)
BUILD_REF=main
# Optional: local artifact cache directory (default: <db dir>/artifacts)
ARTIFACT_CACHE_DIR=./data/artifacts
# Optional: artifact cache retention in days; 0 disables pruning (default: 7)
ARTIFACT_RETENTION_DAYS=7
